# Copiar a .env.firestore y no subir claves o contraseñas al repositorio.
FIRESTORE_PROJECT=facturaflow-mcc-2026
DJANGO_DEBUG=true
# Solo en desarrollo se admite * para acceder desde el celular por la red local.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Crear una clave distinta por entorno para despliegue público.
DJANGO_SECRET_KEY=
