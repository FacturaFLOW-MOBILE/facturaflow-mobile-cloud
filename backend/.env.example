# Copiar a .env y completar. NUNCA versionar el .env real.
DJANGO_SECRET_KEY=cambiar-esta-clave-en-cada-entorno
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos -------------------------------------------------
# Local (contenedor de pruebas)
DB_NAME=facturaflow
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
DB_SSLMODE=prefer

# --- Google Cloud SQL ----------------------------------------------
# Conexion por IP publica con SSL obligatorio:
#   DB_HOST=<IP_PUBLICA_DE_LA_INSTANCIA>
#   DB_PORT=5432
#   DB_SSLMODE=verify-full
#   DB_SSLROOTCERT=/ruta/server-ca.pem
# Conexion por Cloud SQL Auth Proxy (recomendada, sin exponer IP):
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
