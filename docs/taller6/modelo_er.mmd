erDiagram
    APP_USER ||--o{ INVOICE       : "crea"
    APP_USER ||--o{ INVOICE_EVENT : "ejecuta"
    APP_USER ||--o{ AUTH_SESSION  : "abre"
    SUPPLIER ||--o{ INVOICE       : "emite"
    INVOICE  ||--|{ INVOICE_ITEM  : "detalla"
    INVOICE  ||--|{ INVOICE_EVENT : "registra"

    APP_USER {
        uuid id PK "Identificador unico"
        varchar_120 full_name "NOT NULL, min 3 caracteres"
        varchar_254 email UK "NOT NULL, formato validado"
        varchar_255 password_hash "NOT NULL, nunca en claro"
        enum role "emisor | contador | administrador"
        boolean is_active "NOT NULL, DEFAULT TRUE"
        timestamptz created_at "NOT NULL, DEFAULT now()"
        timestamptz updated_at "NOT NULL, mantenido por trigger"
    }

    SUPPLIER {
        uuid id PK "Identificador unico"
        varchar_20 tax_id UK "NIT, patron 0-9 punto guion"
        varchar_160 name "NOT NULL, razon social"
        timestamptz created_at "NOT NULL, DEFAULT now()"
    }

    INVOICE {
        uuid id PK "Identificador unico"
        varchar_40 number UK "Unico junto a supplier_id (Issue 41)"
        uuid supplier_id FK "SUPPLIER.id, ON DELETE RESTRICT"
        date issue_date "NOT NULL, fecha de emision"
        enum status "borrador | enviada | aprobada | rechazada"
        uuid created_by_id FK "APP_USER.id, ON DELETE RESTRICT"
        text notes "NOT NULL, DEFAULT cadena vacia"
        text rejection_reason "min 10 car (Issue 40), NULL salvo rechazada (Issue 42)"
        timestamptz created_at "NOT NULL, DEFAULT now()"
        timestamptz updated_at "NOT NULL, mantenido por trigger"
    }

    INVOICE_ITEM {
        uuid id PK "Identificador unico"
        uuid invoice_id FK "INVOICE.id, ON DELETE CASCADE"
        smallint line_number UK "Unico junto a invoice_id"
        varchar_255 description "NOT NULL, concepto facturado"
        integer quantity "NOT NULL, mayor que cero"
        bigint unit_price_cents "NOT NULL, mayor que cero, en centavos"
        numeric_5_4 tax_rate "NOT NULL, DEFAULT 0.19, entre 0 y 1"
    }

    INVOICE_EVENT {
        uuid id PK "Identificador unico"
        uuid invoice_id FK "INVOICE.id, ON DELETE CASCADE"
        uuid actor_id FK "APP_USER.id, ON DELETE RESTRICT"
        enum status "Estado resultante del evento"
        varchar_255 description "NOT NULL, texto legible"
        text comment "NULL, obligatorio en los rechazos"
        timestamptz occurred_at "NOT NULL, ordena el historial"
    }

    AUTH_SESSION {
        uuid id PK "Identificador unico"
        uuid user_id FK "APP_USER.id, ON DELETE CASCADE"
        varchar_255 token_hash UK "Hash del token, nunca en claro"
        timestamptz issued_at "NOT NULL, emision"
        timestamptz expires_at "NOT NULL, posterior a issued_at"
        timestamptz revoked_at "NULL mientras la sesion siga activa"
    }
